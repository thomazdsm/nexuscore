@{
    ViewData["Title"] = "Confirmação de Envio";
    Layout = "_Layout";
}

<section class="py-lg-7 py-5 bg-light-subtle">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-lg-5 p-4 text-center">
                        <div class="mb-4">
                            <div class="bg-success bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                                 style="width: 100px; height: 100px;">
                                <i class="bi bi-envelope-check fs-1 text-success"></i>
                            </div>
                            <h2 class="h3 mb-2">E-mail enviado com sucesso!</h2>
                            <p class="text-muted mb-4">
                                Enviamos um link para redefinir sua senha para o seu e-mail.
                                Verifique sua caixa de entrada e siga as instruções no e-mail.
                            </p>
                        </div>

                        <div class="bg-light-subtle rounded p-4 mb-4">
                            <h5 class="mb-3">Próximos passos:</h5>
                            <ol class="text-start list-group list-group-flush">
                                <li class="list-group-item bg-transparent border-0 ps-0">
                                    <i class="bi bi-1-circle text-primary me-2"></i>
                                    Verifique sua caixa de entrada
                                </li>
                                <li class="list-group-item bg-transparent border-0 ps-0">
                                    <i class="bi bi-2-circle text-primary me-2"></i>
                                    Clique no link de redefinição no e-mail
                                </li>
                                <li class="list-group-item bg-transparent border-0 ps-0">
                                    <i class="bi bi-3-circle text-primary me-2"></i>
                                    Defina uma nova senha segura
                                </li>
                            </ol>
                        </div>

                        <div class="d-grid gap-2 mb-4">
                            <a href="@Url.Action("Login", "Account")" class="btn btn-primary">
                                <i class="bi bi-arrow-left me-2"></i>
                                Voltar para o Login
                            </a>
                            <a href="@Url.Action("ForgotPassword", "Account")" class="btn btn-outline-primary">
                                <i class="bi bi-arrow-clockwise me-2"></i>
                                Reenviar E-mail
                            </a>
                        </div>

                        <div class="alert alert-info" role="alert">
                            <div class="d-flex align-items-start">
                                <div class="flex-shrink-0">
                                    <i class="bi bi-info-circle"></i>
                                </div>
                                <div class="flex-grow-1 ms-2">
                                    <small>
                                        <strong>Não recebeu o e-mail?</strong><br>
                                        Verifique sua pasta de spam. O link expira em 1 hora.
                                        Se ainda assim não receber, tente reenviar o e-mail.
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>