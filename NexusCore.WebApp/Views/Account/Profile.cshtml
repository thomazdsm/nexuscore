@model NexusCore.WebApp.Models.Account.ProfileViewModel
@{
    ViewData["Title"] = "Perfil do Usuário";
    Layout = "_Layout";
}

<section class="py-lg-7 py-5 bg-light-subtle">
    <div class="container">
        <div class="row">
            <div class="col-lg-3 col-md-4">
                <div class="d-flex align-items-center mb-4 justify-content-center justify-content-md-start">
                    <div class="position-relative">
                        <img src="~/assets/images/avatar/avatar-1.jpg" alt="avatar" class="avatar avatar-lg rounded-circle" />
                        <button class="btn btn-sm btn-primary rounded-circle position-absolute bottom-0 end-0"
                                style="width: 32px; height: 32px; padding: 0;"
                                title="Alterar foto">
                            <i class="bi bi-camera"></i>
                        </button>
                    </div>
                    <div class="ms-3">
                        <h5 class="mb-0">@(Model?.FirstName) @(Model?.LastName)</h5>
                        <small>@Model?.Email</small>
                    </div>
                </div>

                <!-- Menu de Navegação da Conta -->
                <div class="mb-4 text-center text-md-start">
                    <a href="#" class="text-reset">
                        <span>Ver perfil público</span>
                        <span class="ms-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor"
                                 class="bi bi-box-arrow-up-right" viewBox="0 0 16 16">
                                <path fill-rule="evenodd"
                                      d="M8.636 3.5a.5.5 0 0 0-.5-.5H1.5A1.5 1.5 0 0 0 0 4.5v10A1.5 1.5 0 0 0 1.5 16h10a1.5 1.5 0 0 0 1.5-1.5V7.864a.5.5 0 0 0-1 0V14.5a.5.5 0 0 1-.5.5h-10a.5.5 0 0 1-.5-.5v-10a.5.5 0 0 1 .5-.5h6.636a.5.5 0 0 0 .5-.5z" />
                                <path fill-rule="evenodd"
                                      d="M16 .5a.5.5 0 0 0-.5-.5h-5a.5.5 0 0 0 0 1h3.793L6.146 9.146a.5.5 0 1 0 .708.708L15 1.707V5.5a.5.5 0 0 0 1 0v-5z" />
                            </svg>
                        </span>
                    </a>
                </div>

                <div class="d-md-none text-center d-grid">
                    <button class="btn btn-light mb-3 d-flex align-items-center justify-content-between"
                            type="button" data-bs-toggle="collapse" data-bs-target="#collapseAccountMenu"
                            aria-expanded="false" aria-controls="collapseAccountMenu">
                        Menu da Conta
                        <i class="bi bi-chevron-down ms-2"></i>
                    </button>
                </div>

                <div class="collapse d-md-block" id="collapseAccountMenu">
                    <ul class="nav flex-column nav-account">
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Dashboard", "Account")">
                                <i class="align-bottom bx bx-home"></i>
                                <span class="ms-2">Dashboard</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link active" href="@Url.Action("Profile", "Account")">
                                <i class="align-bottom bx bx-user"></i>
                                <span class="ms-2">Perfil</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                <i class="align-bottom bx bx-lock-alt"></i>
                                <span class="ms-2">Segurança</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                <i class="align-bottom bx bx-bell"></i>
                                <span class="ms-2">Notificações</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                <i class="align-bottom bx bx-palette"></i>
                                <span class="ms-2">Aparência</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline w-100">
                                <button type="submit" class="nav-link btn btn-link text-start w-100 border-0 p-0"
                                        style="text-decoration: none;">
                                    <i class="align-bottom bx bx-log-out"></i>
                                    <span class="ms-2">Sair</span>
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>

            <div class="col-lg-9 col-md-8">
                <div class="mb-4">
                    <h1 class="mb-0 h3">Perfil</h1>
                </div>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <!-- Foto do Perfil -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body p-lg-5">
                        <div class="mb-5">
                            <h4 class="mb-1">Foto do Perfil</h4>
                            <p class="mb-0 fs-6">
                                Carregue uma foto para tornar seu perfil mais pessoal e ajudar outros a reconhecê-lo facilmente!
                            </p>
                        </div>
                        <div class="d-flex align-items-center">
                            <div class="position-relative">
                                <img src="~/assets/images/avatar/avatar-1.jpg" alt="avatar"
                                     class="avatar avatar-lg rounded-circle" />
                                <input type="file" id="profilePhoto" class="d-none" accept="image/*" />
                            </div>
                            <div class="ms-4">
                                <h5 class="mb-2">Sua foto</h5>
                                <small class="text-muted d-block mb-3">
                                    Permitido *.jpeg, *.jpg, *.png, *.gif com tamanho máximo de 4 MB
                                </small>
                                <div class="btn-group">
                                    <button type="button" class="btn btn-primary btn-sm"
                                            onclick="document.getElementById('profilePhoto').click()">
                                        <i class="bi bi-upload me-1"></i>
                                        Carregar nova foto
                                    </button>
                                    <button type="button" class="btn btn-outline-danger btn-sm">
                                        <i class="bi bi-trash me-1"></i>
                                        Remover
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Informações da Conta -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body p-lg-5">
                        <div class="mb-5">
                            <h4 class="mb-1">Informações da Conta</h4>
                            <p class="mb-0 fs-6">Edite suas informações pessoais e dados de contato.</p>
                        </div>

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger" role="alert">
                                <div asp-validation-summary="All" class="text-danger"></div>
                            </div>
                        }

                        <form asp-controller="Account" asp-action="Profile" method="post" class="row g-3 needs-validation" novalidate>
                            <div class="col-lg-6 col-md-12">
                                <label asp-for="FirstName" class="form-label">Nome</label>
                                <input asp-for="FirstName" type="text" class="form-control" placeholder="Digite seu nome" />
                                <span asp-validation-for="FirstName" class="invalid-feedback"></span>
                            </div>

                            <div class="col-lg-6 col-md-12">
                                <label asp-for="LastName" class="form-label">Sobrenome</label>
                                <input asp-for="LastName" type="text" class="form-control" placeholder="Digite seu sobrenome" />
                                <span asp-validation-for="LastName" class="invalid-feedback"></span>
                            </div>

                            <div class="col-lg-12">
                                <label asp-for="Email" class="form-label">E-mail</label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-envelope"></i>
                                    </span>
                                    <input asp-for="Email" type="email" class="form-control bg-light" readonly />
                                </div>
                                <div class="form-text">
                                    Para alterar seu e-mail, entre em contato com o suporte.
                                </div>
                            </div>

                            <div class="col-12 mt-4">
                                <button class="btn btn-primary me-2" type="submit">
                                    <i class="bi bi-check2 me-1"></i>
                                    Salvar Alterações
                                </button>
                                <button class="btn btn-light" type="button" onclick="window.location.reload()">
                                    <i class="bi bi-arrow-clockwise me-1"></i>
                                    Cancelar
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Estatísticas da Conta -->
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-lg-5">
                        <div class="mb-4">
                            <h4 class="mb-1">Estatísticas da Conta</h4>
                            <p class="mb-0 fs-6">Informações sobre sua atividade na plataforma.</p>
                        </div>

                        <div class="row g-4">
                            <div class="col-lg-3 col-md-6">
                                <div class="text-center">
                                    <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                                         style="width: 60px; height: 60px;">
                                        <i class="bi bi-calendar-check fs-4 text-primary"></i>
                                    </div>
                                    <h6 class="mb-1">Membro desde</h6>
                                    <p class="text-muted mb-0 small">@DateTime.Now.AddDays(-30).ToString("MMM yyyy")</p>
                                </div>
                            </div>

                            <div class="col-lg-3 col-md-6">
                                <div class="text-center">
                                    <div class="bg-success bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                                         style="width: 60px; height: 60px;">
                                        <i class="bi bi-box-arrow-in-right fs-4 text-success"></i>
                                    </div>
                                    <h6 class="mb-1">Último acesso</h6>
                                    <p class="text-muted mb-0 small">Hoje</p>
                                </div>
                            </div>

                            <div class="col-lg-3 col-md-6">
                                <div class="text-center">
                                    <div class="bg-info bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                                         style="width: 60px; height: 60px;">
                                        <i class="bi bi-shield-check fs-4 text-info"></i>
                                    </div>
                                    <h6 class="mb-1">Status</h6>
                                    <p class="text-muted mb-0 small">Ativo</p>
                                </div>
                            </div>

                            <div class="col-lg-3 col-md-6">
                                <div class="text-center">
                                    <div class="bg-warning bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                                         style="width: 60px; height: 60px;">
                                        <i class="bi bi-star fs-4 text-warning"></i>
                                    </div>
                                    <h6 class="mb-1">Nível</h6>
                                    <p class="text-muted mb-0 small">Básico</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Preview da foto de perfil
        document.getElementById('profilePhoto').addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.querySelector('.avatar').src = e.target.result;
                };
                reader.readAsDataURL(file);
            }
        });

        // Bootstrap validation
        (function() {
            'use strict';
            window.addEventListener('load', function() {
                var forms = document.getElementsByClassName('needs-validation');
                var validation = Array.prototype.filter.call(forms, function(form) {
                    form.addEventListener('submit', function(event) {
                        if (form.checkValidity() === false) {
                            event.preventDefault();
                            event.stopPropagation();
                        }
                        form.classList.add('was-validated');
                    }, false);
                });
            }, false);
        })();
    </script>
}