@{
    ViewData["Title"] = "Confirmação de Registro";
}

<section class="py-lg-7 py-5 bg-light-subtle">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-lg-5 p-4 text-center">
                        <div class="mb-4">
                            <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 100px; height: 100px;">
                                <i class="bi bi-envelope-paper-heart fs-1 text-primary"></i>
                            </div>
                            <h2 class="h3 mb-2">Quase lá!</h2>
                            <p class="text-muted mb-4">
                                Seu cadastro foi realizado com sucesso. Enviamos um e-mail de confirmação para o endereço fornecido. Por favor, verifique sua caixa de entrada (e a pasta de spam) e clique no link para ativar sua conta.
                            </p>
                        </div>
                        <div class="d-grid gap-2">
                            <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Voltar para a Página Inicial</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>