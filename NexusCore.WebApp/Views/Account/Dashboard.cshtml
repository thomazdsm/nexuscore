@{
    ViewData["Title"] = "Dashboard";
    Layout = "_Layout";
}

<section class="py-lg-7 py-5 bg-light-subtle">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="d-flex align-items-center justify-content-between mb-5">
                    <div>
                        <h1 class="h3 mb-0">Bem-vindo ao seu Dashboard!</h1>
                        <p class="text-muted mb-0">Gerencie sua conta e acesse suas funcionalidades</p>
                    </div>
                    <div class="text-end">
                        <small class="text-muted">Último acesso: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4 mb-5">
            <!-- Estatísticas Cards -->
            <div class="col-lg-3 col-md-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="flex-shrink-0">
                                <div class="bg-primary bg-opacity-10 rounded p-3">
                                    <i class="bi bi-person fs-4 text-primary"></i>
                                </div>
                            </div>
                            <div class="flex-grow-1 ms-3">
                                <h6 class="mb-0">Perfil</h6>
                                <p class="text-muted mb-0 small">Completo</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="flex-shrink-0">
                                <div class="bg-success bg-opacity-10 rounded p-3">
                                    <i class="bi bi-shield-check fs-4 text-success"></i>
                                </div>
                            </div>
                            <div class="flex-grow-1 ms-3">
                                <h6 class="mb-0">Segurança</h6>
                                <p class="text-muted mb-0 small">Protegido</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="flex-shrink-0">
                                <div class="bg-info bg-opacity-10 rounded p-3">
                                    <i class="bi bi-bell fs-4 text-info"></i>
                                </div>
                            </div>
                            <div class="flex-grow-1 ms-3">
                                <h6 class="mb-0">Notificações</h6>
                                <p class="text-muted mb-0 small">3 novas</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="flex-shrink-0">
                                <div class="bg-warning bg-opacity-10 rounded p-3">
                                    <i class="bi bi-graph-up fs-4 text-warning"></i>
                                </div>
                            </div>
                            <div class="flex-grow-1 ms-3">
                                <h6 class="mb-0">Atividade</h6>
                                <p class="text-muted mb-0 small">Alta</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <!-- Ações Rápidas -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-bottom">
                        <h5 class="card-title mb-0">Ações Rápidas</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-lg-6">
                                <a href="@Url.Action("Profile", "Account")" class="card border h-100 text-decoration-none">
                                    <div class="card-body d-flex align-items-center">
                                        <div class="flex-shrink-0">
                                            <i class="bi bi-person-gear fs-3 text-primary"></i>
                                        </div>
                                        <div class="flex-grow-1 ms-3">
                                            <h6 class="mb-1">Editar Perfil</h6>
                                            <small class="text-muted">Atualize suas informações pessoais</small>
                                        </div>
                                        <div class="flex-shrink-0">
                                            <i class="bi bi-chevron-right text-muted"></i>
                                        </div>
                                    </div>
                                </a>
                            </div>

                            <div class="col-lg-6">
                                <a href="#" class="card border h-100 text-decoration-none">
                                    <div class="card-body d-flex align-items-center">
                                        <div class="flex-shrink-0">
                                            <i class="bi bi-shield-lock fs-3 text-success"></i>
                                        </div>
                                        <div class="flex-grow-1 ms-3">
                                            <h6 class="mb-1">Segurança</h6>
                                            <small class="text-muted">Gerencie senha e autenticação</small>
                                        </div>
                                        <div class="flex-shrink-0">
                                            <i class="bi bi-chevron-right text-muted"></i>
                                        </div>
                                    </div>
                                </a>
                            </div>

                            <div class="col-lg-6">
                                <a href="#" class="card border h-100 text-decoration-none">
                                    <div class="card-body d-flex align-items-center">
                                        <div class="flex-shrink-0">
                                            <i class="bi bi-gear fs-3 text-info"></i>
                                        </div>
                                        <div class="flex-grow-1 ms-3">
                                            <h6 class="mb-1">Configurações</h6>
                                            <small class="text-muted">Personalize sua experiência</small>
                                        </div>
                                        <div class="flex-shrink-0">
                                            <i class="bi bi-chevron-right text-muted"></i>
                                        </div>
                                    </div>
                                </a>
                            </div>

                            <div class="col-lg-6">
                                <a href="#" class="card border h-100 text-decoration-none">
                                    <div class="card-body d-flex align-items-center">
                                        <div class="flex-shrink-0">
                                            <i class="bi bi-question-circle fs-3 text-warning"></i>
                                        </div>
                                        <div class="flex-grow-1 ms-3">
                                            <h6 class="mb-1">Suporte</h6>
                                            <small class="text-muted">Precisa de ajuda? Fale conosco</small>
                                        </div>
                                        <div class="flex-shrink-0">
                                            <i class="bi bi-chevron-right text-muted"></i>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Atividade Recente -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-bottom">
                        <h5 class="card-title mb-0">Atividade Recente</h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="list-group list-group-flush">
                            <div class="list-group-item border-0 py-3">
                                <div class="d-flex align-items-center">
                                    <div class="flex-shrink-0">
                                        <div class="bg-primary bg-opacity-10 rounded-circle p-2">
                                            <i class="bi bi-box-arrow-in-right text-primary"></i>
                                        </div>
                                    </div>
                                    <div class="flex-grow-1 ms-3">
                                        <h6 class="mb-0 small">Login realizado</h6>
                                        <small class="text-muted">Hoje às @DateTime.Now.ToString("HH:mm")</small>
                                    </div>
                                </div>
                            </div>

                            <div class="list-group-item border-0 py-3">
                                <div class="d-flex align-items-center">
                                    <div class="flex-shrink-0">
                                        <div class="bg-success bg-opacity-10 rounded-circle p-2">
                                            <i class="bi bi-person-check text-success"></i>
                                        </div>
                                    </div>
                                    <div class="flex-grow-1 ms-3">
                                        <h6 class="mb-0 small">Perfil atualizado</h6>
                                        <small class="text-muted">Ontem</small>
                                    </div>
                                </div>
                            </div>

                            <div class="list-group-item border-0 py-3">
                                <div class="d-flex align-items-center">
                                    <div class="flex-shrink-0">
                                        <div class="bg-info bg-opacity-10 rounded-circle p-2">
                                            <i class="bi bi-envelope text-info"></i>
                                        </div>
                                    </div>
                                    <div class="flex-grow-1 ms-3">
                                        <h6 class="mb-0 small">E-mail verificado</h6>
                                        <small class="text-muted">2 dias atrás</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Mensagem de Boas-vindas -->
        <div class="row mt-5">
            <div class="col-12">
                <div class="alert alert-primary border-0 shadow-sm" role="alert">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <i class="bi bi-lightbulb fs-4"></i>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h6 class="alert-heading mb-1">Dica do dia</h6>
                            <p class="mb-0">
                                Mantenha sua conta segura ativando a autenticação de dois fatores nas configurações de segurança.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>