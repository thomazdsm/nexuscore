@model NexusCore.WebApp.Models.Product.ProductViewModel
@{
    ViewData["Title"] = "Editar Produto";
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white border-bottom">
        <h4 class="card-title mb-0">@ViewData["Title"]: @Model.Name</h4>
    </div>
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- Produto -->
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" asp-for="IsActive">
                <label class="form-check-label" asp-for="IsActive"></label>
            </div>

            <!-- Configuração OIDC -->
            <h5 class="mt-4">Configuração de Segurança (OIDC)</h5>
            <hr class="mt-0" />

            @if (Model.OpenIddictApplicationId.HasValue)
            {
                <input type="hidden" asp-for="OpenIddictApplicationId" value="@Model.LinkedApplication?.Id" />
                <!-- Editar app já vinculado -->
                <div class="alert alert-info">
                    <p class="mb-1"><strong>Application ID:</strong> @Model.LinkedApplication?.Id</p>
                    <p class="mb-1"><strong>Display Name:</strong> @Model.LinkedApplication?.DisplayName</p>
                    <p class="mb-0"><strong>Client ID:</strong> @Model.LinkedApplication?.ClientId</p>
                </div>

                <div class="mb-3">
                    <label asp-for="RedirectUri" class="form-label"></label>
                    <input asp-for="RedirectUri" class="form-control" />
                    <span asp-validation-for="RedirectUri" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="PostLogoutRedirectUri" class="form-label"></label>
                    <input asp-for="PostLogoutRedirectUri" class="form-control" />
                    <span asp-validation-for="PostLogoutRedirectUri" class="text-danger"></span>
                </div>
            }
            else
            {
                <!-- Selecionar app para vincular -->
                <div class="mb-3">
                    <label asp-for="OpenIddictApplicationId" class="form-label"></label>
                    <select asp-for="OpenIddictApplicationId" class="form-select" asp-items="@Model.AvailableApplications">
                        <option value="">[Selecione uma aplicação para vincular]</option>
                    </select>
                    <span asp-validation-for="OpenIddictApplicationId" class="text-danger"></span>
                </div>
            }

            <!-- Botões -->
            <div class="mt-4">
                <button type="submit" class="btn btn-primary">Salvar Alterações</button>
                <a asp-action="Index" class="btn btn-light ms-2">Cancelar</a>

                @if (Model.OpenIddictApplicationId.HasValue)
                {
                    <button type="submit" class="btn btn-outline-danger ms-2"
                            asp-action="Unlink" asp-route-id="@Model.Id">
                        <i class="bi bi-x-lg"></i> Desvincular Aplicação
                    </button>
                }
            </div>
        </form>
    </div>
</div>
