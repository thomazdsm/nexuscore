@model NexusCore.Application.DTOs.ProductDto
@{
    ViewData["Title"] = "Detalhes do Produto";
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white border-bottom">
        <h4 class="card-title mb-0">@ViewData["Title"]: @Model.Name</h4>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">ID</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Id)</dd>

            <dt class="col-sm-3">Nome</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Name)</dd>

            <dt class="col-sm-3">Descrição</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Description)</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
                @if (Model.IsActive)
                {
                    <span class="badge bg-success">Ativo</span>
                }
                else
                {
                    <span class="badge bg-danger">Inativo</span>
                }
            </dd>
        </dl>
    </div>
    <div class="card-footer bg-white">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
        <a asp-action="Index" class="btn btn-light ms-2">Voltar para a Lista</a>
    </div>
</div>